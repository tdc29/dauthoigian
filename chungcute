   .site-footer {

  background-color: #eaf6f6;
  padding: 50px 20px 20px;
  font-family: "Segoe UI", sans-serif;
  color: #5a4a2e;
}

.footer-container {
  max-width: 1200px;
  margin: auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 30px;
}

.site-footer h3,
.site-footer h4 {
  margin-bottom: 12px;
  color: #3e5f5c;
}

.site-footer p,
.site-footer a {
  font-size: 14px;
  line-height: 1.6;
}

.footer-center ul {
  list-style: none;
  padding: 0;
}

.footer-center li {
  margin-bottom: 8px;
}

.footer-center a {
  text-decoration: none;
  color: #5a4a2e;
  transition: color 0.3s;
}

.footer-center a:hover {
  color: #2f7d73;
}

.footer-bottom {
  text-align: center;
  margin-top: 40px;
  padding-top: 15px;
  border-top: 1px solid #e0e0e0;
  font-size: 13px;
  color: #6b5b3e;
}

